{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "files": {
    "includes": [
      "!public",
      "!components/ui",
      // Satori OG image components (ogimagecn registry): rendered to PNG via
      // next/og, so DOM rules like noImgElement don't apply.
      "!components/og",
      "!hooks/use-mobile.ts",
      "!lib/utils.ts",
      "!.source"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        // Inline JSX handlers are idiomatic React; this app has no render
        // hot paths where handler identity matters.
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      // Migration/smoke scripts run SQL statements sequentially on purpose.
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    }
  ]
}
